# JoliTableau - Environment Configuration
# Copy this file to .env and update with your values

# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.jolitableau.com

# Database (PostgreSQL for production)
USE_POSTGRES=False
DB_NAME=jolitableau
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# AWS Configuration (Production)
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=jolitableau-media
AWS_S3_REGION_NAME=eu-west-3

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=your-sendgrid-user
EMAIL_HOST_PASSWORD=your-sendgrid-password
DEFAULT_FROM_EMAIL=noreply@jolitableau.com

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# Payment Providers
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
MOLLIE_API_KEY=test_your-mollie-api-key

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# AI Services
OPENAI_API_KEY=your-openai-api-key
GROK_API_KEY=your-grok-api-key

# Elasticsearch
ELASTICSEARCH_HOST=localhost:9200

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://jolitableau.com

# Logging
LOG_LEVEL=INFO

# JoliTableau Pricing (EUR)
JOLITABLEAU_DOMAIN_PRICE=9.99
JOLITABLEAU_BOOST_PRICE=4.99
JOLITABLEAU_WHATSAPP_MESSAGE_PRICE=0.05
JOLITABLEAU_FAIR_LISTING_PRICE=49.00
JOLITABLEAU_COMMISSION_RATE=0.10

# Conseil des Sages
CONSEIL_MAX_MEMBERS=20

# Trial Period (days)
DOMAIN_TRIAL_PERIOD=30
