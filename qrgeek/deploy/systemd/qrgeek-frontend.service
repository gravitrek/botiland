[Unit]
Description=QRGeek Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/qrgeek/frontend
Environment="PATH=/usr/bin:/usr/local/bin"
Environment="NODE_ENV=production"
EnvironmentFile=/var/www/qrgeek/frontend/.env.production

ExecStart=/usr/bin/npm start
ExecReload=/bin/kill -s HUP $MAINPID

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
